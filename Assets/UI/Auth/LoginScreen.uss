/* ========================================
   RYVALEN — LOGIN SCREEN v2
   Premium Tactical FPS Interface
   Dual-Color Rivalry + Decorative Details
======================================== */

/* Global Font */
* {
    -unity-font-definition: url('project://database/Assets/Fonts/WhirlyBirdie-WideBold.otf?fileID=12800000&guid=3dbce92e7e9156543aa54fb9ca2c7a54&type=3#Whirly Birdie');
}

:root {
    --rival-a: rgb(255, 95, 50);
    --rival-a-bright: rgb(255, 130, 85);
    --rival-a-glow: rgba(255, 95, 50, 0.4);
    --rival-a-subtle: rgba(255, 95, 50, 0.12);
    --rival-b: rgb(0, 195, 240);
    --rival-b-bright: rgb(60, 215, 255);
    --rival-b-glow: rgba(0, 195, 240, 0.35);
    --rival-b-subtle: rgba(0, 195, 240, 0.10);
    --bg-abyss: rgb(6, 6, 10);
    --bg-panel: rgba(10, 10, 16, 0.94);
    --bg-input: rgba(8, 8, 14, 0.75);
    --border-dim: rgb(30, 30, 38);
    --border-mid: rgb(50, 50, 60);
    --text-primary: rgb(230, 232, 238);
    --text-secondary: rgb(140, 142, 155);
    --text-ghost: rgba(180, 182, 195, 0.75);
    --success-green: rgb(80, 255, 160);
    --error-red: rgb(255, 75, 110);
}

/* ========================================
   BACKGROUND
======================================== */
.background {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--bg-abyss);
    background-image: url('project://database/Assets/Textures/LoginBackground.png');
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
}

/* ========================================
   SCAN LINE OVERLAY & DARKENING
   Helps disguise low-res backgrounds
======================================== */
.scan-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.65);
    opacity: 1;
}

/* ========================================
   RIVAL ICON IMAGE LOGO
======================================== */
.rival-icon-watermark {
    width: 480px;
    height: 140px;
    margin-bottom: 24px;
    background-image: url('project://database/Assets/UI/Sprites/RivalIcon.png');
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: white;
    opacity: 1;
}

/* ========================================
   MAIN CONTAINER
======================================== */
.main-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

/* ========================================
   GLASS PANEL — Rivalry Frame
   With corner bracket space
======================================== */
.glass-panel {
    width: 88%;
    max-width: 490px;
    min-width: 360px;
    padding-top: 50px;
    padding-bottom: 45px;
    padding-left: 48px;
    padding-right: 48px;
    background-color: var(--bg-panel);
    border-radius: 0;
    position: relative;

    /* Dual rivalry borders */
    border-top-width: 3px;
    border-top-color: var(--rival-a);
    border-left-width: 4px;
    border-left-color: var(--rival-a);
    border-bottom-width: 2px;
    border-bottom-color: var(--rival-b);
    border-right-width: 1px;
    border-right-color: rgba(0, 195, 240, 0.3);

    transition-property: border-color;
    transition-duration: 0.3s;
}

/* ========================================
   CORNER BRACKETS — Valorant-style
   Decorative L-shaped corners
======================================== */
.corner-tl, .corner-tr, .corner-bl, .corner-br {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: transparent;
    border-width: 0;
}

.corner-tl {
    top: -1px;
    left: -1px;
    border-top-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--rival-a-bright);
    border-left-color: var(--rival-a-bright);
}

.corner-tr {
    top: -1px;
    right: -1px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.2);
    border-right-color: rgba(0, 195, 240, 0.5);
}

.corner-bl {
    bottom: -1px;
    left: -1px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-bottom-color: rgba(0, 195, 240, 0.5);
    border-left-color: rgba(255, 255, 255, 0.15);
}

.corner-br {
    bottom: -1px;
    right: -1px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-bottom-color: var(--rival-b);
    border-right-color: var(--rival-b);
}

/* Success panel green corners */
.corner-success {
    border-top-color: var(--success-green) !important;
    border-left-color: var(--success-green) !important;
    border-bottom-color: var(--success-green) !important;
    border-right-color: var(--success-green) !important;
}

/* ========================================
   DIVIDER LINE — Decorative Separator
======================================== */
.divider-line {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 95, 50, 0.2);
    margin-bottom: 30px;
    margin-top: -10px;

    /* Simulate gradient via border */
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 195, 240, 0.1);
}

.divider-success {
    background-color: rgba(80, 255, 160, 0.25);
    border-bottom-color: rgba(80, 255, 160, 0.1);
}

/* ========================================
   STATUS TEXT
======================================== */
.status-text {
    font-size: 38px;
    color: var(--text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
    margin-top: 0;
    min-height: 44px;
    white-space: normal;
    letter-spacing: 8px;
    text-shadow: 0 0 30px var(--rival-a-glow);
}

.status-error {
    color: var(--error-red);
    text-shadow: 0 0 20px rgba(255, 75, 110, 0.5);
}

/* ========================================
   INPUT GROUPS
======================================== */
.input-group {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    background-color: var(--bg-input);
    border-radius: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 18px;
    padding-right: 18px;
    height: 66px;

    border-width: 1px;
    border-color: var(--border-dim);
    border-left-width: 3px;
    border-left-color: rgba(255, 95, 50, 0.4);

    transition-property: background-color, border-left-color, border-color;
    transition-duration: 0.25s;
}

.input-group:hover {
    background-color: rgba(15, 15, 22, 0.88);
    border-color: var(--border-mid);
    border-left-color: var(--rival-a);
}

.input-group:focus-within {
    background-color: rgba(18, 18, 28, 0.92);
    border-left-color: var(--rival-a-bright);
    border-color: rgba(255, 95, 50, 0.2);
}

/* ── Input Icon ── */
.input-icon {
    font-size: 10px;
    color: rgba(255, 95, 50, 0.45);
    margin-right: 14px;
    min-width: 14px;
    -unity-text-align: middle-center;

    transition-property: color;
    transition-duration: 0.2s;
}

.input-group:hover .input-icon {
    color: var(--rival-a);
}

.icon-special {
    color: rgba(0, 195, 240, 0.45);
}

.input-group:hover .icon-special {
    color: var(--rival-b);
}

/* ── Input Fields ── */
.custom-input {
    flex-grow: 1;
    border-width: 0;
    background-color: transparent;
    font-size: 16px;
    color: var(--text-primary);
    padding: 0;
    margin: 0;
    letter-spacing: 2px;
}

.custom-input > .unity-text-element {
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    font-size: 16px;
    color: var(--text-primary);
}

.custom-input > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 16px;
    color: var(--text-primary);
}

.custom-input:focus {
    background-color: transparent;
}

.custom-input > .unity-base-field__input > .unity-text-element--placeholder {
    color: var(--text-secondary);
    letter-spacing: 3px;
}

/* ========================================
   PRIMARY BUTTON + Shine Effect
======================================== */
.btn-primary {
    height: 70px;
    margin-top: 28px;
    margin-bottom: 18px;
    background-color: var(--rival-a);
    color: var(--bg-abyss);
    font-size: 20px;
    -unity-font-style: bold;
    border-radius: 0;
    letter-spacing: 6px;
    position: relative;
    overflow: hidden;

    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: var(--rival-b);

    transition-property: background-color, scale, border-bottom-color;
    transition-duration: 0.15s;
}

.btn-primary:hover {
    background-color: var(--rival-a-bright);
    border-bottom-color: var(--rival-b-bright);
    scale: 1.025;
}

.btn-primary:active {
    background-color: rgb(215, 70, 30);
    scale: 0.97;
    border-bottom-color: var(--rival-b);
}

/* Shine overlay inside button */
.btn-shine {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 45%;
    background-color: rgba(255, 255, 255, 0.07);
    picking-mode: ignore; /* Important to not block button clicks! */
}

/* ========================================
   SECONDARY BUTTON
======================================== */
.btn-secondary {
    height: 54px;
    background-color: transparent;
    color: var(--text-ghost);
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 0;
    letter-spacing: 3px;

    border-width: 1px;
    border-color: var(--border-dim);
    border-left-width: 2px;
    border-left-color: rgba(0, 195, 240, 0.3);

    transition-property: color, background-color, border-color, border-left-color;
    transition-duration: 0.2s;
}

.btn-secondary:hover {
    color: var(--text-primary);
    background-color: var(--rival-b-subtle);
    border-color: rgba(0, 195, 240, 0.35);
    border-left-color: var(--rival-b);
}

.btn-secondary:active {
    background-color: rgba(0, 195, 240, 0.06);
    scale: 0.97;
}

/* ========================================
   PANEL TAGLINE — Bottom Flavor Text
======================================== */
.panel-tagline {
    font-size: 10px;
    color: rgba(255, 95, 50, 0.35);
    -unity-text-align: middle-center;
    letter-spacing: 5px;
    margin-top: 22px;
    margin-bottom: 0;
}

/* ========================================
   VERSION TAG — Bottom-Right
======================================== */
.version-tag {
    position: absolute;
    bottom: 22px;
    right: 28px;
    font-size: 10px;
    color: rgba(0, 195, 240, 0.3);
    letter-spacing: 3px;
}

/* ========================================
   HIDDEN
======================================== */
.hidden {
    display: none;
}

/* ========================================
   SUCCESS PANEL
======================================== */
.success-glow {
    color: var(--success-green);
    font-size: 40px;
    letter-spacing: 5px;
    text-shadow: 0 0 35px rgba(80, 255, 160, 0.5);
}

.success-message {
    font-size: 19px;
    color: var(--text-primary);
    -unity-text-align: middle-center;
    margin-bottom: 30px;
    margin-top: 18px;
    white-space: normal;
    letter-spacing: 1px;
}

.character-display {
    font-size: 30px;
    color: var(--success-green);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 40px;
    padding: 22px;
    background-color: rgba(8, 8, 14, 0.7);
    border-radius: 0;
    border-width: 1px;
    border-color: var(--border-dim);
    border-left-width: 3px;
    border-left-color: var(--success-green);
    text-shadow: 0 0 15px rgba(80, 255, 160, 0.3);
}

/* ========================================
   LOADING OVERLAY
======================================== */
.loading-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(4, 4, 8, 0.96);
    justify-content: center;
    align-items: center;
}

.loading-panel {
    align-items: center;
    justify-content: center;
    width: 400px;
}

.loading-spinner {
    width: 130px;
    height: 130px;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
}

.spinner-segment {
    font-size: 85px;
    color: var(--rival-a);
    rotate: 0deg;
    text-shadow: 0 0 35px var(--rival-a-glow);
}

.loading-message {
    font-size: 28px;
    color: var(--rival-a);
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-bottom: 15px;
    text-shadow: 0 0 25px var(--rival-a-glow);
}

.loading-subtext {
    font-size: 14px;
    color: var(--text-secondary);
    letter-spacing: 5px;
    opacity: 0.7;
    margin-bottom: 30px;
}

/* ── Loading Progress Bar ── */
.loading-bar-bg {
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 0;
    overflow: hidden;
}

.loading-bar-fill {
    width: 35%;
    height: 100%;
    background-color: var(--rival-a);

    transition-property: width;
    transition-duration: 0.5s;
}

/* ========================================
   MUTE BUTTON
======================================== */
.mute-button {
    position: absolute;
    bottom: 22px;
    left: 22px;
    width: 48px;
    height: 48px;
    background-color: rgba(10, 10, 16, 0.8);
    border-width: 1px;
    border-color: rgba(255, 95, 50, 0.25);
    border-radius: 0;
    align-items: center;
    justify-content: center;
    padding: 0;

    border-left-width: 2px;
    border-left-color: rgba(255, 95, 50, 0.5);

    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.mute-button:hover {
    background-color: var(--rival-a-subtle);
    border-color: var(--rival-a);
    border-left-color: var(--rival-a-bright);
}

.mute-icon {
    font-size: 22px;
    color: var(--rival-a);
    -unity-text-align: middle-center;
}

.mute-button.muted .mute-icon {
    color: var(--text-secondary);
    opacity: 0.4;
}
