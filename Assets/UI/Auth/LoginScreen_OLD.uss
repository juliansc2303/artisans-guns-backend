/* ========================================
   BACKGROUND
======================================== */
.background {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(42, 35, 28);
    background-image: url('project://database/Assets/Textures/LoginBackground.png');
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
}

/* Logo in top-left corner */
.logo {
    position: absolute;
    left: 50px;
    top: 50px;
    width: 220px;
    height: 220px;
    min-width: 180px;
    min-height: 180px;
    background-image: url('project://database/Assets/Textures/BirdHeadLogo.svg');
    -unity-background-scale-mode: scale-to-fit;
    transition-duration: 0.3s;
}

.logo:hover {
    scale: 1.05;
}

/* ========================================
   MAIN CONTAINER
======================================== */
.main-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

/* ========================================
   GLASSMORPHISM PANEL
======================================== */
.glass-panel {
    width: 90%;
    max-width: 520px;
    min-width: 320px;
    padding: 50px 45px;
    background-color: rgba(80, 70, 60, 0.35);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
    transition-duration: 0.4s;
}

.glass-panel:hover {
    background-color: rgba(80, 70, 60, 0.4);
    scale: 1.02;
}

/* ========================================
   STATUS TEXT (replaces title and error text)
======================================== */
.status-text {
    font-size: 22px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 30px;
    margin-top: 5px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    letter-spacing: 1px;
    min-height: 30px;
    white-space: normal;
    overflow: visible;
    flex-wrap: wrap;
}

/* Status text when showing error */
.status-error {
    color: rgb(255, 100, 100);
    text-shadow: 2px 2px 6px rgba(255, 0, 0, 0.5);
}

/* ========================================
   INPUT GROUPS
======================================== */
.input-group {
    flex-direction: row;
    align-items: center;
    margin-bottom: 22px;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 12px;
    padding: 8px 18px;
    height: 55px;
    transition-duration: 0.3s;
}

.input-group:hover {
    background-color: rgba(255, 255, 255, 1);
    scale: 1.03;
}

/* Input Icons */
.input-icon {
    width: 28px;
    height: 28px;
    min-width: 24px;
    min-height: 24px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.username-icon {
    background-image: resource('Icons/user-icon'); /* Unity built-in icon */
    -unity-background-image-tint-color: rgb(120, 120, 120);
}

.password-icon {
    background-image: resource('Icons/lock-icon');
    -unity-background-image-tint-color: rgb(120, 120, 120);
}

.character-icon {
    background-image: resource('Icons/star-icon');
    -unity-background-image-tint-color: rgb(120, 120, 120);
}

/* ========================================
   CUSTOM INPUT FIELDS
======================================== */
.custom-input {
    flex-grow: 1;
    border-width: 0;
    background-color: transparent;
    font-size: 18px;
    color: rgb(40, 40, 40);
    padding: 0;
    margin: 0;
}

.custom-input > .unity-text-element {
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    font-size: 18px;
}

.custom-input > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 18px;
}

.custom-input:focus {
    background-color: transparent;
}

.custom-input > TextElement {
    color: rgb(40, 40, 40);
    font-size: 18px;
}

/* ========================================
   BUTTONS
======================================== */
.btn-primary {
    height: 58px;
    margin-top: 12px;
    margin-bottom: 18px;
    background-color: rgb(0, 180, 235);
    color: white;
    font-size: 19px;
    -unity-font-style: bold;
    border-radius: 12px;
    border-width: 0;
    letter-spacing: 2px;
    transition-duration: 0.3s;
}

.btn-primary:hover {
    background-color: rgb(0, 200, 255);
    scale: 1.05;
}

.btn-primary:active {
    scale: 0.98;
}

.btn-secondary {
    height: 48px;
    background-color: transparent;
    color: rgba(255, 255, 255, 0.8);
    font-size: 15px;
    -unity-font-style: bold;
    border-radius: 10px;
    border-width: 0;
    letter-spacing: 1px;
    transition-duration: 0.3s;
}

.btn-secondary:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.1);
    scale: 1.03;
}

.btn-secondary:active {
    scale: 0.98;
}

/* ========================================
   LOADING OVERLAY
======================================== */
.loading-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    align-items: center;
}

.loading-text {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
}

/* ========================================
   UTILITY CLASSES
======================================== */
.hidden {
    display: none;
}

/* ========================================
   ANIMATIONS (via C#)
======================================== */
.fade-in {
    transition-duration: 0.5s;
    opacity: 1;
}

.fade-out {
    transition-duration: 0.5s;
    opacity: 0;
}
