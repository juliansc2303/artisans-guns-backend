/* ===================================
   ROOM SCREEN - TACTICAL OVERHAUL
   Inspired by Valorant & Concept Image
   =================================== */

/* Global Font - WhirlyBirdie */
* {
    -unity-font-definition: url('project://database/Assets/Fonts/WhirlyBirdie-WideBold.otf?fileID=12800000&guid=3dbce92e7e9156543aa54fb9ca2c7a54&type=3#WhirlyBirdie-WideBold');
}

:root {
    --color-bg-deep: rgb(10, 10, 12);
    --color-bg-panel: rgba(20, 20, 25, 0.9);
    --color-accent-amber: rgb(255, 95, 50);
    --color-border-tactical: rgb(45, 45, 50);
    --color-team-a: rgb(255, 95, 50);
    --color-team-b: rgb(0, 195, 240);
    --color-text-main: rgb(220, 220, 225);
    --color-text-dim: rgb(150, 150, 160);
}

/* ===================================
   TAB CONTENT SYSTEM
   =================================== */
.tab-content {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 0;
}

.room-content {
    /* Room-specific background if needed */
    padding-top: 140px; /* Space for persistent header */
}

.weapons-content {
    padding: 180px 40px 40px 40px; /* Extra top padding for persistent header */
    justify-content: flex-start;
    align-items: center;
}

.agents-content {
    padding: 180px 40px 40px 40px; /* Extra top padding for persistent header */
    justify-content: flex-start;
    align-items: center;
}

.tab-title {
    font-size: 32px;
    color: var(--color-accent-amber);
    letter-spacing: 3px;
    margin-bottom: 10px;
    -unity-font-style: bold;
}

.tab-subtitle {
    font-size: 16px;
    color: var(--color-text-dim);
    letter-spacing: 1px;
}

.hidden {
    display: none;
}

/* Background - Deep Matte */
.background {
    width: 100%;
    height: 100%;
    background-color: rgb(10, 10, 12);
    flex-grow: 1;
    background-image: resource('UI/RoomBackground');
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.7);
}

/* Main Container */
.main-container {
    width: 100%;
    height: 100%;
    padding: 0;
    flex-direction: column;
}

/* ===================================
   HEADER - NAVIGATION & LOGO
   =================================== */
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin: 0;
    padding: 10px 40px 15px 20px;
    background-color: rgba(15, 15, 20, 0.85);
    border-bottom-width: 2px;
    border-bottom-color: var(--color-border-tactical);
}

.left-nav-buttons {
    flex-direction: row;
    align-items: flex-end;
    gap: 0;
}

/* Logo Button - Centered */
.logo-button {
    width: 250px;
    height: 110px;
    position: absolute;
    left: 50%;
    translate: -50% 0;
    top: 15px;
    background-color: transparent;
    border-width: 0 0 3px 0;
    border-bottom-color: transparent;
    border-radius: 0;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition-property: border-bottom-color;
    transition-duration: 0.3s;
    cursor: link;
}

.logo-button:hover {
    border-bottom-color: var(--color-accent-amber);
}

.logo-button-active {
    border-bottom-color: var(--color-accent-amber);
}

.logo-icon {
    width: 250px;
    height: 125px;
    background-image: resource('UI/RivalIcon');
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 95, 50);
    margin: 0;
    padding: 0;
}

.logo-label {
    font-size: 11px;
    color: rgb(180, 180, 185);
    letter-spacing: 2px;
    margin-top: -15px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

/* Navigation Buttons */
.nav-button {
    background-color: transparent;
    border-width: 0 0 3px 0;
    border-bottom-color: transparent;
    border-radius: 0;
    padding: 10px 25px 8px 25px;
    min-width: 80px;
    flex-direction: column;
    align-items: center;
    transition-property: border-bottom-color, background-color;
    transition-duration: 0.25s;
    cursor: link;
    margin: 0;
}

.nav-button:hover {
    background-color: rgba(255, 255, 255, 0.03);
    border-bottom-color: rgba(255, 95, 50, 0.4);
}

.nav-button-active {
    border-bottom-color: rgb(255, 95, 50);
}

.nav-icon {
    font-size: 28px;
    color: rgb(200, 200, 205);
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.nav-button-active .nav-icon {
    color: rgb(255, 95, 50);
}

.nav-label {
    font-size: 11px;
    color: rgb(180, 180, 190);
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.nav-button-active .nav-label {
    color: rgb(240, 240, 245);
}

/* Players Count - Right Side */
.players-count-header {
    font-size: 20px;
    color: var(--color-accent-amber);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-top: 8px;
}

/* ===================================
   TEAMS CONTAINER
   =================================== */
.content-area {
    flex-direction: column;
    padding: 20px 30px 0 30px;
    align-items: stretch;
}

.panel {
    background-color: var(--color-bg-panel);
    border-width: 1px;
    border-color: var(--color-border-tactical);
    padding: 0; /* Let children handle padding or use absolute headers */
    overflow: hidden;
}

.team-panel {
    flex-grow: 1;
    margin: 0 10px;
    min-height: 480px;
    max-height: 500px;
}

.panel-title {
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    letter-spacing: 4px;
    padding: 12px;
    -unity-text-align: middle-center;
}

/* Team Variants */
#TeamAPanel {
    border-top-width: 4px;
    border-top-color: rgb(255, 95, 50);
    border-left-width: 4px;
    border-left-color: rgb(255, 95, 50);
}
#TeamAPanel .panel-title {
    background-color: rgba(255, 95, 50, 0.25);
    color: rgb(255, 95, 50);
}

#TeamBPanel {
    border-top-width: 4px;
    border-top-color: rgb(0, 195, 240);
    border-left-width: 4px;
    border-left-color: rgb(0, 195, 240);
}
#TeamBPanel .panel-title {
    background-color: rgba(0, 195, 240, 0.25);
    color: rgb(0, 195, 240);
}

/* ===================================
   PLAYER LISTS
   =================================== */
.players-list {
    flex-grow: 1;
    padding: 15px;
    background-color: rgba(0, 0, 0, 0.2);
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: nowrap;
}

.player-item {
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    margin-bottom: 8px;
    padding: 12px 20px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.player-item.local {
    border-left-width: 4px;
    border-left-color: var(--color-accent-amber);
    background-color: rgba(255, 95, 50, 0.05);
}

.player-name {
    font-size: 18px;
    color: var(--color-text-main);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.player-character {
    font-size: 11px;
    color: var(--color-text-dim);
}

.player-badge {
    font-size: 10px;
    color: var(--color-accent-amber);
    border-width: 1px;
    border-color: var(--color-accent-amber);
    padding: 4px 8px;
    letter-spacing: 1px;
}

/* ===================================
   MAP INFO PANEL
   =================================== */
.map-info-panel {
    flex-direction: row;
    flex-grow: 1;
    margin: 10px 40px 5px 40px;
    background-color: rgba(15, 15, 20, 0.9);
    border-width: 1px;
    border-color: var(--color-border-tactical);
}

.map-details {
    flex-direction: column;
    width: 280px;
    padding: 20px 25px 20px 20px;
    justify-content: flex-start;
}

.map-header-label {
    font-size: 24px;
    color: var(--color-accent-amber);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.room-details-list {
    flex-direction: column;
    flex-grow: 1;
}

.detail-item {
    font-size: 13px;
    color: var(--color-text-dim);
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.map-preview {
    flex-grow: 1;
    padding: 10px;
    justify-content: flex-end;
    align-items: stretch;
    flex-direction: row;
}

.map-image {
    height: 100%;
    min-height: 300px;
    width: 540px;
    background-color: rgba(60, 60, 70, 0.3);
    border-width: 1px;
    border-color: var(--color-border-tactical);
    /* background-image will be set dynamically via C# */
    -unity-background-scale-mode: scale-to-fit;
}

.right-section {
    display: none;
}

/* ===================================
   LOADOUT MODAL
   =================================== */
.modal-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.modal-content {
    width: 500px;
    background-color: rgba(20, 20, 25, 0.98);
    border-width: 2px;
    border-color: var(--color-accent-amber);
    padding: 30px;
}

.modal-title {
    font-size: 24px;
    color: var(--color-accent-amber);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 25px;
    -unity-text-align: middle-center;
}

.loadout-selectors {
    flex-direction: column;
    margin-bottom: 25px;
}

.selector-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
}

.selector-label {
    width: 120px;
    font-size: 13px;
    color: var(--color-text-main);
    letter-spacing: 2px;
}

.selector-dropdown {
    flex-grow: 1;
    height: 35px;
    background-color: rgba(40, 40, 45, 0.8);
    border-width: 1px;
    border-color: var(--color-border-tactical);
    color: var(--color-text-main);
    font-size: 13px;
    padding-left: 10px;
}

.modal-buttons {
    flex-direction: row;
    justify-content: center;
}

.btn-modal-cancel, .btn-modal-confirm {
    height: 45px;
    min-width: 130px;
    margin: 0 8px;
    font-size: 14px;
    letter-spacing: 2px;
    border-width: 1px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
}

.btn-modal-cancel {
    background-color: transparent;
    border-color: rgba(255, 50, 50, 0.5);
    color: rgb(255, 100, 100);
}

.btn-modal-cancel:hover {
    background-color: rgba(255, 50, 50, 0.15);
    border-color: rgb(255, 50, 50);
    scale: 1.03;
}

.btn-modal-confirm {
    background-color: var(--color-accent-amber);
    border-color: var(--color-accent-amber);
    color: black;
    -unity-font-style: bold;
}

.btn-modal-confirm:hover {
    background-color: rgb(255, 115, 70);
    scale: 1.03;
}

/* ===================================
   CONTROLS & FOOTER
   =================================== */
.bottom-controls {
    height: 100px;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    border-top-width: 1px;
    border-top-color: var(--color-border-tactical);
    background-color: rgba(10, 10, 12, 0.8);
}

.btn-ready, .btn-start-game {
    height: 60px;
    min-width: 300px;
    background-color: var(--color-accent-amber);
    border-width: 0;
    color: black;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}

.btn-ready:hover, .btn-start-game:hover {
    background-color: rgb(255, 115, 70);
    scale: 1.05;
}

.btn-ready:disabled {
    background-color: var(--color-border-tactical);
    color: var(--color-text-dim);
}

/* ===================================
   COUNTDOWN
   =================================== */
.countdown-overlay {
    background-color: rgba(0, 0, 0, 0.95);
}

.countdown-label {
    font-size: 180px;
    color: var(--color-accent-amber);
    -unity-font-style: bold;
    text-shadow: 0 0 30px rgba(255, 95, 50, 0.4);
}

.countdown-message {
    font-size: 24px;
    color: var(--color-text-main);
    letter-spacing: 10px;
}

.players-count-label {
    color: var(--color-text-dim);
}

.waiting-label {
    color: var(--color-text-dim);
}

.hidden {
    display: none;
}
