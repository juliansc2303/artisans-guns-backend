
/* ===================================
   PLAYER HUD - MIDDLE BOTTOM
   =================================== */

.player-hud-bottom {
    position: absolute;
    bottom: 40px;
    width: 600px;
    left: 50%;
    margin-left: -300px;
    align-items: center;
    justify-content: center;
}

.health-container {
    width: 100%;
    flex-direction: column;
    align-items: center;
}

.health-value-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    margin-bottom: 5px;
    letter-spacing: 2px;
}

.health-bar-bg {
    width: 100%;
    height: 12px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    overflow: hidden;
}

.health-bar-fill-main {
    width: 100%;
    height: 100%;
    /* Gradient from Teal to Blueish */
    background-image: none;
    background-color: rgb(0, 225, 255); 
    border-radius: 6px;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-circ;
}
