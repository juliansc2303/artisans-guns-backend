/* ===================================
   SETTINGS PANEL - FULL SCREEN NO TRANSPARENCY
   Created: Feb 24, 2026
   =================================== */

.settings-panel-root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(15, 15, 20);
    position: absolute;
    left: 0;
    top: 0;
    display: none;
}

.settings-panel-root.visible {
    display: flex;
}

/* HEADER */
.settings-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 30px 50px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(40, 175, 255, 0.3);
    height: 100px;
    background-color: rgba(10, 10, 15, 0.9);
}

.settings-title {
    font-size: 42px;
    color: rgb(220, 220, 225);
    -unity-font-style: bold;
    letter-spacing: 6px;
}

.settings-close-btn {
    width: 60px;
    height: 60px;
    background-color: rgba(255, 80, 40, 0.2);
    border-width: 2px;
    border-color: rgba(255, 80, 40, 0.5);
    border-radius: 8px;
    font-size: 32px;
    color: rgb(255, 100, 100);
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.settings-close-btn:hover {
    background-color: rgba(255, 80, 40, 0.4);
    border-color: rgb(255, 80, 40);
}

.settings-close-btn:active {
    scale: 0.95;
}

/* CONTENT AREA */
.settings-content {
    flex-grow: 1;
    padding: 40px 50px;
    overflow-y: auto;
}

/* SECTION */
.settings-section {
    flex-direction: column;
    margin-bottom: 50px;
}

.settings-section-title {
    font-size: 20px;
    color: rgb(40, 175, 255);
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 25px;
    padding-bottom: 10px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(40, 175, 255, 0.3);
}

/* SETTINGS ITEM */
.settings-item {
    flex-direction: column;
    margin-bottom: 40px;
    background-color: rgba(20, 20, 30, 0.5);
    border-width: 1px;
    border-color: rgba(40, 175, 255, 0.15);
    padding: 25px;
    border-radius: 4px;
}

.settings-label {
    font-size: 18px;
    color: rgb(220, 220, 225);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.settings-value-row {
    flex-direction: row;
    align-items: center;
    gap: 20px;
}

.settings-slider {
    flex-grow: 1;
    min-height: 30px;
    background-color: rgba(40, 175, 255, 0.1);
    border-radius: 15px;
}

.settings-slider > .unity-base-slider__tracker {
    background-color: rgba(40, 175, 255, 0.3);
    border-width: 0;
    border-radius: 15px;
}

.settings-slider > .unity-base-slider__dragger {
    background-color: rgb(40, 175, 255);
    border-width: 0;
    border-radius: 50%;
    width: 30px;
    height: 30px;
}

.settings-value-label {
    font-size: 24px;
    color: rgb(40, 175, 255);
    -unity-font-style: bold;
    min-width: 60px;
    text-alignment: middle-center;
}

/* FOOTER */
.settings-footer {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 20px 50px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
    gap: 30px;
    height: 80px;
    background-color: rgba(10, 10, 15, 0.9);
}

/* Smaller, subtle action button (replaces the old full-width logout) */
.settings-btn-action {
    height: 40px;
    padding: 0 24px;
    background-color: rgba(255, 80, 40, 0.15);
    border-width: 1px;
    border-color: rgba(255, 80, 40, 0.4);
    color: rgb(255, 120, 100);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-radius: 6px;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.settings-btn-action:hover {
    background-color: rgba(255, 80, 40, 0.35);
    border-color: rgb(255, 80, 40);
}

.settings-btn-action:active {
    scale: 0.95;
}

/* Keep old class for backward compat */
.settings-btn-logout {
    height: 40px;
    padding: 0 24px;
    background-color: rgba(255, 80, 40, 0.15);
    border-width: 1px;
    border-color: rgba(255, 80, 40, 0.4);
    color: rgb(255, 120, 100);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-radius: 6px;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.settings-btn-logout:hover {
    background-color: rgba(255, 80, 40, 0.35);
    border-color: rgb(255, 80, 40);
}

.settings-btn-logout:active {
    scale: 0.95;
}

/* ROOM CODE — centered below header */
.settings-header-right {
    flex-direction: row;
    align-items: center;
    gap: 16px;
}

.settings-room-code-center {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 20px;
    margin: 10px auto 0 auto;
    background-color: rgba(255, 107, 61, 0.1);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 107, 61, 0.3);
    align-self: center;
}

.settings-room-code-inline {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background-color: rgba(255, 107, 61, 0.1);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 107, 61, 0.3);
}

.room-code-label-sm {
    font-size: 12px;
    color: rgba(255, 107, 61, 0.7);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.room-code-value-sm {
    font-size: 18px;
    color: rgb(255, 107, 61);
    -unity-font-style: bold;
    letter-spacing: 4px;
}

/* EXIT CONFIRM DIALOG */
.exit-confirm-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
}

.exit-confirm-box {
    background-color: rgb(20, 20, 28);
    border-width: 2px;
    border-color: rgba(255, 80, 40, 0.5);
    border-radius: 10px;
    padding: 30px 40px;
    align-items: center;
    width: 380px;
}

.exit-confirm-title {
    font-size: 24px;
    color: rgb(255, 100, 100);
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.exit-confirm-msg {
    font-size: 14px;
    color: rgba(220, 220, 225, 0.8);
    -unity-text-align: upper-center;
    margin-bottom: 24px;
    white-space: normal;
}

.exit-confirm-buttons {
    flex-direction: row;
    gap: 16px;
}

.exit-confirm-btn {
    height: 40px;
    padding: 0 28px;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    border-radius: 6px;
    border-width: 1px;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.exit-confirm-yes {
    background-color: rgba(255, 80, 40, 0.3);
    border-color: rgba(255, 80, 40, 0.6);
    color: rgb(255, 120, 100);
}

.exit-confirm-yes:hover {
    background-color: rgba(255, 80, 40, 0.5);
    border-color: rgb(255, 80, 40);
}

.exit-confirm-no {
    background-color: rgba(40, 175, 255, 0.15);
    border-color: rgba(40, 175, 255, 0.4);
    color: rgb(40, 175, 255);
}

.exit-confirm-no:hover {
    background-color: rgba(40, 175, 255, 0.3);
    border-color: rgb(40, 175, 255);
}

/* ROOM CODE SECTION (legacy — kept for backward compat) */
.room-code-section {
    margin-bottom: 20px;
    padding: 16px 24px;
    background-color: rgba(255, 107, 61, 0.08);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 107, 61, 0.3);
    align-items: center;
}

.room-code-display {
    font-size: 32px;
    letter-spacing: 8px;
    color: rgb(255, 107, 61);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

/* SCROLLBAR STYLING */
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroller__slider {
    width: 8px;
    margin: 0;
    margin-right: 5px;
}

.unity-base-slider__tracker {
    background-color: rgba(40, 175, 255, 0.2);
    border-width: 0;
}

.unity-base-slider__dragger {
    background-color: rgb(40, 175, 255);
    border-width: 0;
    border-radius: 4px;
}
