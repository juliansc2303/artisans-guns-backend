# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/

# Memory capance files
[Mm]emoryCaptures/

# Recordings
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Lighting data
**/[Ll]ightingData.asset

# Autogenerated files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Burst debug information
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# TextMeshPro
[Aa]ssets/TextMesh*Pro/

# VS Code
.vscode/
.utmp/

# Keystore (NEVER commit)
*.keystore
*.jks

# Large Firebase native libraries (>100MB, exceed GitHub limit)
Assets/Firebase/Plugins/x86_64/FirebaseCppApp*
Assets/Plugins/iOS/Firebase/libFirebaseCppApp*
Assets/Plugins/tvOS/Firebase/libFirebaseCppApp*

# Backend node_modules
Backend/node_modules/

# Temp/debug files
temp_*.txt
hs_err_*.log

# Generated assets backup
GeneratedAssets_deleted/

# Backups
Backups/

# OS files
.DS_Store
Thumbs.db

# Documentation (optional - uncomment to exclude)
# DOCS/
